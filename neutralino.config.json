{
  "$schema": "https://raw.githubusercontent.com/neutralinojs/neutralino.js/main/bin/resources/neutralino.config.schema.json",
  "applicationId": "com.papersnews.app",
  "version": "0.1.0",
  "defaultMode": "window",
  "port": 0,
  "documentRoot": "/resources/",
  "url": "/",
  "enableServer": false,
  "enableNativeAPI": true,
  "tokenSecurity": "one-time",
  "logging": {
    "enabled": true,
    "writeToLogFile": false
  },
  "nativeAllowList": [
    "os.open"
  ],
  "modes": {
    "window": {
      "title": "Papers News",
      "width": 1120,
      "height": 780,
      "minWidth": 720,
      "minHeight": 560,
      "center": true,
      "resizable": true,
      "maximizable": true,
      "exitProcessOnClose": true
    }
  },
  "cli": {
    "binaryName": "papers-news",
    "resourcesPath": "/resources/",
    "extensionsPath": "/extensions/",
    "clientLibrary": "/resources/js/neutralino.js",
    "binaryVersion": "5.6.0",
    "clientVersion": "5.6.0"
  }
}
