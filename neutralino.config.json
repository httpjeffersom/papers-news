{
  "$schema": "https://raw.githubusercontent.com/neutralinojs/neutralino.js/main/bin/resources/neutralino.config.schema.json",
  "applicationId": "com.papersnews.app",
  "version": "0.10.0",
  "applicationName": "Papers News",
  "author": "Jeffersom",
  "description": "Leitor pessoal de notícias RSS/Atom para desktop.",
  "defaultMode": "window",
  "port": 51789,
  "documentRoot": "/resources/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": true,
  "tokenSecurity": "one-time",
  "exportAuthInfo": false,
  "dataLocation": "system",
  "storageLocation": "system",
  "logging": {
    "enabled": true,
    "writeToLogFile": false
  },
  "nativeAllowList": [
    "os.open",
    "os.spawnProcess"
  ],
  "serverHeaders": {
    "content-security-policy": "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; frame-src 'none'; form-action 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https: http:; font-src 'self' data:; media-src 'none'; connect-src 'self' http://127.0.0.1:8787 ws://127.0.0.1:51789; worker-src 'none'; manifest-src 'self'",
    "cross-origin-opener-policy": "same-origin",
    "permissions-policy": "camera=(), microphone=(), geolocation=(), payment=(), usb=()",
    "referrer-policy": "no-referrer",
    "x-content-type-options": "nosniff",
    "x-frame-options": "DENY"
  },
  "modes": {
    "window": {
      "title": "Papers News",
      "icon": "/resources/app-icon.png",
      "width": 1120,
      "height": 780,
      "minWidth": 720,
      "minHeight": 560,
      "center": true,
      "resizable": true,
      "maximizable": true,
      "enableInspector": false,
      "newWindowPolicy": "browser",
      "exitProcessOnClose": true
    }
  },
  "cli": {
    "binaryName": "papers-news",
    "resourcesPath": "/resources/",
    "extensionsPath": "/extensions/",
    "clientLibrary": "/resources/js/neutralino.js",
    "binaryVersion": "5.6.0",
    "clientVersion": "5.6.0"
  }
}
